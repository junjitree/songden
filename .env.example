# songden settings. Copy to .env, fill in, keep it private (chmod 600).

# Who the player is for. Names the home-screen app ("Mia") and the badge
# ("Mia's Songs"), and is trimmed from playlist names on tiles ("Mia - Moana"
# shows as "Moana"). Letters, digits, spaces, apostrophes and hyphens only.
LISTENER=Mia
# PLAYLIST_PREFIX=Mia   # if the playlists use a different prefix

# The family password, hashed. Make the hash with:
#   echo -n 'the password' | docker compose run --rm -T songden hash-password
# (or `echo -n 'the password' | cargo run -q -- hash-password`).
# Put it in single quotes: it contains `$`.
FAMILY_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'
# Raise to the current Unix time to sign every device out.
SESSIONS_SINCE=0
# Only for plain-HTTP testing on localhost:
# SECURE_COOKIES=false

# Playlist links or ids added on first start (comma-separated). After that,
# add and remove them on the grown-ups' page.
SEED_PLAYLISTS=

# Where songs are kept inside the container (mount a volume there), and the
# yt-dlp command; the defaults suit the image.
# MUSIC_DIR=/music
# YTDLP=yt-dlp
# Songs fetched side by side; 1 is kindest to YouTube. Raise it (2-3) for a big
# first import, then set it back.
# FETCH_PARALLEL=1
